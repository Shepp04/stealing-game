		<Item class="LocalScript" referent="RBX2d8baa2fd4484d76a19256952421c3b6">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--!strict
-- // Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- // Packages
local Packages = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Packages"))
local Debounce = Packages.Debounce
local Sounds = Packages.Sounds

-- // Remotes
local Remotes = Packages.Remotes
local LeaveMatchRemote = Remotes:GetRemote("RemoteEvent", "LeaveMatch") :: RemoteEvent

-- // Gui
local Gui = script.Parent
local Button = Gui:WaitForChild("Leave"):WaitForChild("Select")

local debounce = false
Button.MouseButton1Click:Connect(function()
	Sounds:PlaySound("UIClick01")
	if (debounce) then return end
	debounce = true
	
	task.delay(0.25, function()
		debounce = false
	end)
	
	LeaveMatchRemote:FireServer()
end)

local function initialise()
	Sounds:PlaySound("JoinMatch")
end

-- Initialisation
initialise()]]></ProtectedString>
