		<Item class="LocalScript" referent="RBXd469b0c99309489983c0a8c12ceff436">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--!strict
-- // Services
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

-- // Packages
local Packages = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Packages"))

-- // Remotes
local Remotes = Packages.Remotes
local ReferralRewardReceived = Remotes:GetRemote("RemoteEvent", "ReferralRewardReceived") :: RemoteEvent

-- // Helpers
local function get(root: Instance, path: {string})
	local cur = root
	for _, name in ipairs(path) do cur = cur:WaitForChild(name) end
	return cur
end

-- // Gui
local Gui = script.Parent
local Menu = get(Gui, {"ReferralMenu"})
local RewardLabel = get(Menu, {"Frame", "TextContent", "Reward"}) :: TextLabel
local CloseButton = get(Menu, {"Frame", "Close", "Button"}) :: TextButton

-- // Tweens
local openTween: Tween
local closeTween: Tween

local function close()
	closeTween:Play()
	closeTween.Completed:Wait()
	Gui.Enabled = false
end

local function showReferralReward(reward: { CurrencyID: string, Amount: number })
	RewardLabel.Text = string.format(
		"You received %s %s from inviting friends!",
		tostring(reward.Amount), reward.CurrencyID
	)
	Gui.Enabled = true
	openTween:Play()
end

local function initialise()
	-- // Create Tweens
	openTween = TweenService:Create(
		Menu, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
		{GroupTransparency = 0}
	)
	closeTween = TweenService:Create(
		Menu, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{GroupTransparency = 1}
	)
	
	-- // Connect Remotes
	ReferralRewardReceived.OnClientEvent:Connect(showReferralReward)
	
	-- // Connect Buttons
	CloseButton.MouseButton1Click:Connect(close)
	
	closeTween:Play()
	Gui.Enabled = false
end

-- Initialisation
initialise()]]></ProtectedString>
